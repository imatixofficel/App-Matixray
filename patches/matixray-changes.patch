+/** The round connect button with its animated ring while connected. */
+@Composable
+private fun ConnectOrb(isRunning: Boolean, onToggle: () -> Unit) {
+    val scheme = MaterialTheme.colorScheme
+    val label = stringResource(if (isRunning) R.string.mx_bar_btn_connected else R.string.mx_bar_btn_connect)
+    val fill = if (isRunning) {
+        Brush.linearGradient(listOf(XfMint, XfMintDark))
+    } else {
+        Brush.linearGradient(listOf(lerp(scheme.primary, Color.White, 0.18f), scheme.primary))
+    }
+    val glow = if (isRunning) XfMint else scheme.primary
+    Box(modifier = Modifier.size(86.dp), contentAlignment = Alignment.Center) {
+        if (isRunning) ConnectOrbRings(color = XfMint)
+        Box(
+            modifier = Modifier
+                .size(62.dp)
+                .shadow(8.dp, CircleShape, ambientColor = glow, spotColor = glow)
+                .clip(CircleShape)
+                .background(fill)
+                .semantics { contentDescription = label }
+                .clickable(role = Role.Button, onClick = onToggle),
+            contentAlignment = Alignment.Center,
+        ) {
+            Icon(
+                painter = painterResource(R.drawable.ic_power_24dp),
+                contentDescription = null,
+                tint = Color.White,
+                modifier = Modifier.size(30.dp),
+            )
+        }
+    }
+}
+
+/** Two rings around the button: one turns (a bright arc that fades behind it), one spreads out and fades, both without end. */
+@Composable
+private fun ConnectOrbRings(color: Color) {
+    val transition = rememberInfiniteTransition(label = "connectOrb")
+    val turn by transition.animateFloat(
+        initialValue = 0f,
+        targetValue = 360f,
+        animationSpec = infiniteRepeatable(tween(2200, easing = LinearEasing)),
+        label = "orbTurn",
+    )
+    val spread by transition.animateFloat(
+        initialValue = 0f,
+        targetValue = 1f,
+        animationSpec = infiniteRepeatable(tween(1800, easing = LinearOutSlowInEasing)),
+        label = "orbSpread",
+    )
+    Canvas(modifier = Modifier.fillMaxSize()) {
+        val stroke = 3.dp.toPx()
+        val inner = 62.dp.toPx() / 2f + 5.dp.toPx()
+        val outer = size.minDimension / 2f - stroke
+        drawCircle(
+            color = color.copy(alpha = (1f - spread) * 0.55f),
+            radius = inner + (outer - inner) * spread,
+            style = Stroke(width = stroke),
+        )
+        rotate(turn) {
+            drawCircle(
+                brush = Brush.sweepGradient(listOf(Color.Transparent, color)),
+                radius = inner,
+                style = Stroke(width = stroke, cap = StrokeCap.Round),
+            )
+        }
+    }
+}
 
 
