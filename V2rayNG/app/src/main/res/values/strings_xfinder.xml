    <string name="mx_tour_welcome_title">Welcome to Matixray</string>
    <string name="mx_tour_welcome_body">A short tour shows where everything is. You only see it the first time.</string>
    <string name="mx_tour_connect_title">Connect button</string>
    <string name="mx_tour_connect_body">One tap connects to the selected config, another tap disconnects.</string>
    <string name="mx_tour_sections_title">Two main sections</string>
    <string name="mx_tour_sections_body">Switch between Matixray and Psiphon. Psiphon connects without any config.</string>
    <string name="mx_tour_tab_configs_title">Configs</string>
    <string name="mx_tour_tab_configs_body">All your configs and groups are listed in this tab.</string>
    <string name="mx_tour_add_title">Add a config</string>
    <string name="mx_tour_add_body">Add a config from a QR code, the clipboard, a file or by hand.</string>
    <string name="mx_tour_ping_title">Ping all</string>
    <string name="mx_tour_ping_body">Tests the real ping of every config. Green is healthy, red is a timeout.</string>
    <string name="mx_tour_best_title">Best config</string>
    <string name="mx_tour_best_body">The star finds the fastest config and connects to it by itself.</string>
    <string name="mx_tour_bar_title">Connection bar</string>
    <string name="mx_tour_bar_body">See the state of the connection. Tap the text to test it and see the ping right there, and use the button to connect or disconnect.</string>
    <string name="mx_tour_tab_settings_title">Settings</string>
    <string name="mx_tour_tab_settings_body">Every section of the old menu is now in the Settings tab.</string>
    <string name="mx_tour_tools_title">Matix tools</string>
    <string name="mx_tour_tools_body">Xfinder, the IP scanner and the logs are here, with subscriptions, routing, backup and the rest below.</string>
